mercury
<- concept_planet;
<- concept_terrestrial_planet;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Меркурий](* <- lang_ru;; *);
=> nrel_main_idtf:
    [Mercury](* <- lang_en;; *);
=> nrel_note: [ближайшая к Солнцу планета земной группы, самый маленький из восьми планет](* <- lang_ru;; *);
=> nrel_orbits: sun;
=> nrel_belongs_to_system: solar_system;
=> nrel_distance_from_sun: [0,39 а.е.](* <- lang_ru;; *);
=> nrel_equatorial_diameter: [4879 км](* <- lang_ru;; *);
=> nrel_number_of_satellites: [0];
=> nrel_orbital_period: [88 суток](* <- lang_ru;; *);
=> nrel_interesting_fact: [Сутки на Меркурии длятся 176 земных суток: планета очень медленно вращается вокруг оси.](* <- lang_ru;; *);
=> nrel_preceded: venus;;
