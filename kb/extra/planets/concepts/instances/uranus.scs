uranus
<- concept_planet;
<- concept_ice_giant;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Уран](* <- lang_ru;; *);
=> nrel_main_idtf:
    [Uranus](* <- lang_en;; *);
=> nrel_note: [седьмая планета от Солнца, ледяной гигант, ось вращения которого почти лежит в плоскости орбиты](* <- lang_ru;; *);
=> nrel_orbits: sun;
=> nrel_belongs_to_system: solar_system;
=> nrel_distance_from_sun: [19,2 а.е.](* <- lang_ru;; *);
=> nrel_equatorial_diameter: [51118 км](* <- lang_ru;; *);
=> nrel_number_of_satellites: [28];
=> nrel_orbital_period: [84 года](* <- lang_ru;; *);
=> nrel_interesting_fact: [Уран «катается на боку»: наклон оси составляет около 98 градусов.](* <- lang_ru;; *);
=> nrel_preceded: neptune;;
