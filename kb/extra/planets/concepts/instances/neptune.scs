neptune
<- concept_planet;
<- concept_ice_giant;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Нептун](* <- lang_ru;; *);
=> nrel_main_idtf:
    [Neptune](* <- lang_en;; *);
=> nrel_note: [восьмая и самая дальняя из больших планет Солнечной системы, ледяной гигант](* <- lang_ru;; *);
=> nrel_orbits: sun;
=> nrel_belongs_to_system: solar_system;
=> nrel_distance_from_sun: [30,1 а.е.](* <- lang_ru;; *);
=> nrel_equatorial_diameter: [49528 км](* <- lang_ru;; *);
=> nrel_number_of_satellites: [16];
=> nrel_orbital_period: [165 лет](* <- lang_ru;; *);
=> nrel_interesting_fact: [Нептун был предсказан математически по возмущениям орбиты Урана и открыт в 1846 году.](* <- lang_ru;; *);;
