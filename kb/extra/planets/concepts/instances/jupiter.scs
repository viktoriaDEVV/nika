jupiter
<- concept_planet;
<- concept_gas_giant;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Юпитер](* <- lang_ru;; *);
=> nrel_main_idtf:
    [Jupiter](* <- lang_en;; *);
=> nrel_note: [пятая планета от Солнца и крупнейшая планета Солнечной системы, газовый гигант](* <- lang_ru;; *);
=> nrel_orbits: sun;
=> nrel_belongs_to_system: solar_system;
=> nrel_distance_from_sun: [5,2 а.е.](* <- lang_ru;; *);
=> nrel_equatorial_diameter: [142984 км](* <- lang_ru;; *);
=> nrel_number_of_satellites: [95];
=> nrel_orbital_period: [11,86 года](* <- lang_ru;; *);
=> nrel_interesting_fact: [Большое красное пятно Юпитера — антициклон, наблюдаемый уже более 300 лет.](* <- lang_ru;; *);
=> nrel_preceded: saturn;;
