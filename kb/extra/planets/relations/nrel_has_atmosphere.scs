nrel_has_atmosphere
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
    [имеет атмосферу*] (* <- lang_ru;; *);
=> nrel_main_idtf:
    [has atmosphere*] (* <- lang_en;; *);
=> nrel_first_domain:
    concept_planet;
=> nrel_second_domain:
    concept_atmosphere;;
